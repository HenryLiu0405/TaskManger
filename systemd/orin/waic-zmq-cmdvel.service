[Unit]
Description=ZMQ bridge: /cmd_vel CycloneDDS(0) → Fast-DDS(66)

[Service]
Type=simple
ExecStart=/bin/bash -c 'python3 /home/unitree/waic_bridge/zmq_bridge.py sub rmw_cyclonedds_cpp 0 /cmd_vel geometry_msgs/msg/Twist 5562 & python3 /home/unitree/waic_bridge/zmq_bridge.py pub rmw_fastrtps_cpp 66 /cmd_vel geometry_msgs/msg/Twist 5562 & trap "kill 0" EXIT; wait'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
