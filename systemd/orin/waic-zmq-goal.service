[Unit]
Description=ZMQ bridge: /goal_pose Fast-DDS(66) → CycloneDDS(0)

[Service]
Type=simple
ExecStart=/bin/bash -c 'python3 /home/unitree/waic_bridge/zmq_bridge.py sub rmw_fastrtps_cpp 66 /goal_pose geometry_msgs/msg/PoseStamped 5561 & python3 /home/unitree/waic_bridge/zmq_bridge.py pub rmw_cyclonedds_cpp 0 /goal_pose geometry_msgs/msg/PoseStamped 5561 & trap "kill 0" EXIT; wait'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
