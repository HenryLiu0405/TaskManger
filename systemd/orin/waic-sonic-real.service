[Unit]
Description=WAIC SONIC Policy (真机物理)
After=network.target

[Service]
Type=simple
StandardInput=null
WorkingDirectory=/home/unitree/GR00T-WholeBodyControl-phi/gear_sonic_deploy
ExecStartPre=-/usr/bin/rm -f /tmp/waic-sonic-real-cmd.fifo
ExecStartPre=/usr/bin/mkfifo /tmp/waic-sonic-real-cmd.fifo
ExecStart=/bin/bash -c '\
  source scripts/setup_env.sh && \
  export ROS_DOMAIN_ID=66 && \
  export HAS_ROS2=1 && \
  ./deploy.sh --input-type ros2_manager --output-type zmq real < /tmp/waic-sonic-real-cmd.fifo & \
  DEPLOY_PID=$$!; \
  exec 3>/tmp/waic-sonic-real-cmd.fifo; \
  echo Y >&3; \
  wait $$DEPLOY_PID'
ExecStop=/bin/bash -c 'echo o > /tmp/waic-sonic-real-cmd.fifo 2>/dev/null; true'
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
