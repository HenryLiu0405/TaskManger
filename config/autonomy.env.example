# Copy these names into the deployment secret manager or process environment.
# Never put a real key in this repository.
GEMINI_API_KEY=replace-with-a-new-rotated-key

# Google's documented standard, non-streaming Robotics ER 2 preview endpoint.
# "gemini-flash-latest" is a general Gemini alias, not an ER 2 identity.
GEMINI_ROBOTICS_MODEL=gemini-robotics-er-2-preview

# ER 2's official quick start uses Interactions. The adapter also retains a
# generate_content compatibility mode for the generic curl request shape.
GEMINI_API_MODE=interactions

# Optional HTTPS endpoint override for a provider-specific/private-preview URL.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/...

# Keep provider-side storage disabled unless retention has been approved.
GEMINI_STORE_RESPONSES=false
